PORT=5000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000

# Clerk backend verification (leave unset for local no-auth mode)
CLERK_SECRET_KEY=sk_test_...
CLERK_INGESTION_ADMIN_USER_IDS=user_...

# Optional Redis; the backend falls back to memory if unset or unavailable
REDIS_URL=redis://localhost:6379
REDIS_CACHE_PREFIX=finrag:cache:

# SEC discovery and resumable ingestion
SEC_USER_AGENT=FinRAG contact@example.com
SEC_COMPANY_CACHE_TTL_MS=86400000
INGESTION_STATE_PATH=./data/ingestion-state.json
INGESTION_STAGING_PATH=./data/ingestion-staging

GEMINI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
UPSTREAM_TIMEOUT_MS=30000
UPSTREAM_MAX_ATTEMPTS=3
UPSTREAM_RETRY_BASE_MS=250
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
CHAT_CACHE_TTL_MS=60000
CHAT_CACHE_MAX_ENTRIES=100
